# It will download Ubuntu image only and won't create any container 
sudo docker pull ubuntu

# List out the Docker images
sudo docker image ls

# create the container and  run with interactive mode
sudo docker run -it ubuntu

# Check whether the container is running or not
sudo docker container ls

# list out the container with the exit container also
sudo docker container ls -a

# same function of 5 lines, but we are giving a specific name to the container
sudo docker run -it --name containername ubuntu

#  List out what processes are done inside the container
sudo docker logs containername

# same function as 11 line but the container is in detached mode
sudo docker run -d --name containername ubuntu

sudo docker run -d -it --name containername ubuntu
# container run in background and bash is running because of -it
sudo docker exec -it containername mkdir test
# we can make directory inside the container without login the container (container should run then only it's possible)
